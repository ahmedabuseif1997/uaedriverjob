# Copy this file to .env and fill in real values for local development.
# In DigitalOcean App Platform, these are set as encrypted app-level environment variables instead.

# --- Database (DigitalOcean Managed PostgreSQL in production, docker-compose locally) ---
DATABASE_URL="postgresql://uaedriverjob:uaedriverjob@localhost:5432/uaedriverjob?schema=public"

# --- App ---
# Base URL of the deployed app, used to build absolute links (emails, Stripe redirect URLs, sitemap).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Random 32+ byte secret used to sign/verify session-related tokens. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# --- Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Price IDs for one-time job-post tiers (mode: payment)
STRIPE_PRICE_JOB_STANDARD=""
STRIPE_PRICE_JOB_FEATURED=""
STRIPE_PRICE_JOB_URGENT=""
# Stripe Price IDs for recurring subscription plans (mode: subscription)
STRIPE_PRICE_SUB_BASIC=""
STRIPE_PRICE_SUB_PRO=""
STRIPE_PRICE_SUB_ENTERPRISE=""

# --- DigitalOcean Spaces (S3-compatible object storage) ---
DO_SPACES_ENDPOINT=""
DO_SPACES_REGION=""
DO_SPACES_BUCKET=""
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
# Public CDN base URL for the bucket, used to build public file URLs.
DO_SPACES_CDN_URL=""
